# Regenerated by build.sh / packaging/stage_layout.py / package builds.
# Kept out of the repo; CI rebuilds everything from source.
/build/
**/node_modules/
**/__pycache__/
*.pyc
/packages/npm/natives/
/packages/npm/native-packages/
/packages/npm/sysroot/
/packages/python/tinyc/natives/
/packages/python/tinyc/sysroot/
/packages/python/dist-wheels/
/packages/java/dist/
/packages/android/local.properties
# Staged by packages/android/build.sh native-libs (NDK build outputs).
/packages/android/src/main/jniLibs/*/libtinyc*.so
/packages/android/src/main/assets/toolchain/*/include/*.h
/packages/android/src/main/assets/toolchain/*/lib/*.a
/packages/android/src/main/assets/toolchain/*/lib/*.o
/packages/android/src/main/assets/toolchain/*/lib/*.tbd
/packages/android/src/main/assets/toolchain/*/win32/**
# Staged by packages/android/build.sh native-libs from the
# top-level build's android dists (bionic sysroot).
/packages/android/src/main/assets/sysroot/*/include/**
/packages/android/src/main/assets/sysroot/*/lib/**
/wasm-backend/build-src/
/wasm-backend/work/
mac-test-bundle/tinyc-mac-test.tar.gz
.DS_Store
/packages/java/build/
# Browser package build outputs (Emscripten modules staged at the
# package root by packages/browser/build.sh).
/packages/browser/build/
/packages/browser/tcc-*.mjs
/packages/browser/tcc-*.wasm
/packages/browser/tcc-*.tinyc.js
/packages/browser/sysroot/
/packages/npm/*.tgz
/wasm-backend/build-install/
/wasm-backend/build.log
/wasm-backend/sysroot/
