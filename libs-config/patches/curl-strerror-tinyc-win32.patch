Bundled-build patch: libcurl's Curl_strerror() reads the CRT
messages through sys_errlist/sys_nerr on _WIN32. The bundled
win32 headers declare those variables without the dllimport
decoration TCC's PE linker requires for data in a DLL, so
the link fails. Under TCC, read the same CRT messages
through strerror(), keeping the CRT-before-Winsock
preference by range (the bundled errno set ends at 42).

--- a/lib/strerror.c
+++ b/lib/strerror.c
@@ -851,8 +851,17 @@
 #if defined(_WIN32) || defined(_WIN32_WCE)
 #if defined(_WIN32)
   /* 'sys_nerr' is the maximum errno number, it is not widely portable */
+#ifdef __TINYC__
+  /* The bundled win32 headers declare sys_errlist/sys_nerr
+     without the dllimport decoration the PE linker requires,
+     so read the same CRT messages through strerror() instead.
+     The bundled errno set ends at EILSEQ (42). */
+  if(err >= 0 && err <= 42)
+    msnprintf(buf, buflen, "%s", strerror(err));
+#else
   if(err >= 0 && err < sys_nerr)
     msnprintf(buf, buflen, "%s", sys_errlist[err]);
+#endif
   else
 #endif
   {
