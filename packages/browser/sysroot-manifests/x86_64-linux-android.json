    {
      "path": "/sysroot/include/tcclib.h",
      "source": "tcclib.h"
    }
  ],
  "libDir": "/sysroot/lib",
  "libFiles": [
    {
      "binary": true,
      "path": "/sysroot/lib/libtcc1.a",
      "source": "lib/x86_64-linux-android/libtcc1.a"
    },
    {
      "binary": true,
      "path": "/sysroot/lib/crt1.o",
      "source": "lib/x86_64-linux-android/crt1.o"
