{
  "name": "@xnetx/tinyc",
  "version": "0.5.4",
  "description": "TinyC (TCC) embedded compiler: one dual-form native file (executable + library) with bundled headers and libraries, driven from Node.js via koffi.",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "bundle": "node bundle_native.js"
  },
  "license": "LGPL-2.1-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xnetsc/tinyc-in-one.git",
    "directory": "packages/npm"
  },
  "files": [
    "index.js",
    "natives",
    "sysroot",
    "packaging-manifest.json",
    "README.md",
    "README.zh-CN.md"
  ],
  "optionalDependencies": {
    "@xnetx/tinyc-native-aarch64-linux-gnu": "0.5.4",
    "@xnetx/tinyc-native-apple-darwin": "0.5.4",
    "@xnetx/tinyc-native-x86_64-linux-gnu": "0.5.4",
    "@xnetx/tinyc-native-x86_64-w64-mingw32": "0.5.4"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  }
}
